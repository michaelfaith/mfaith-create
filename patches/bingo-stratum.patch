+export function createBlockExtension(block, props, name) {
+    const created = { block, props };
+    if (name) {
+        Object.defineProperty(created, "toJSON", {
+            value: () => ({ block: `[Block ${name}]`, props }),
+        });
+    }
+    return created;
+}
